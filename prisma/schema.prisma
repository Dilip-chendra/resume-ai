generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  firstName     String?
  lastName      String?
  imageUrl      String?
  tier          Tier     @default(FREE)
  credits       Int      @default(3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  resumeSample  String?  @db.Text
  coverLetterSample String? @db.Text

  resumes       Resume[]
  atsReports    AtsReport[]
  jobs          Job[]
  coverLetters  CoverLetter[]
  providerKeys  ProviderKey[]
}

enum Tier {
  FREE
  PRO
  ENTERPRISE
}

model Resume {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  content     Json
  templateId  String?
  template    Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  atsReports  AtsReport[]
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  thumbnail   String?
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resumes     Resume[]
}

model Job {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  company     String
  description String
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  atsReports  AtsReport[]
}

model AtsReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  score       Int
  missingKeys String[]
  suggestions Json
  createdAt   DateTime @default(now())
}

model CoverLetter {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     String
  targetJob   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProviderKey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  key         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
}
